# Todas opcionales: la plataforma levanta sin ninguna. Copia a .env y ajusta.
#
# Aca NO van secretos de Canvas. La cookie de sesion de cada usuario vive fuera
# del repositorio, en %LOCALAPPDATA%\plataforma-estudio\<usuario>\canvas_session,
# y se pega desde la pantalla Cookie de Canvas.

# Donde escucha el servidor.
PLATAFORMA_PUERTO=8080
# 127.0.0.1 a proposito: esto guarda sesiones de Canvas de personas reales.
# Solo cambialo si sabes a que red lo estas exponiendo.
PLATAFORMA_HOST=127.0.0.1

# Ruta del archivo de usuarios. Util para levantar una instancia de prueba sin
# tocar la configuracion real.
# PLATAFORMA_USUARIOS=./usuarios.json

# Pimienta del hash de contraseñas. Si la cambias, las contraseñas existentes
# dejan de validar: es para elegirla una vez, al principio.
# PLATAFORMA_SECRETO=

# "cerrado" deja la creacion de usuarios solo en manos de un administrador.
# PLATAFORMA_REGISTRO=cerrado

# El modelo local. Tiene que estar bajado: ollama pull llama3.1
OLLAMA_URL=http://127.0.0.1:11434
PLATAFORMA_MODELO=llama3.1:latest
# Milisegundos. Una guia son varias llamadas seguidas.
# PLATAFORMA_MODELO_TIMEOUT=180000

# El motor de LaTeX. pdflatex por defecto porque no depende de fuentes
# instaladas; xelatex sirve si quieres la tipografia de marca.
# PLATAFORMA_LATEX=pdflatex
# Ruta al binario, si no esta en el PATH.
# PLATAFORMA_LATEX_BIN=
# PLATAFORMA_LATEX_TIMEOUT=60000

# Donde se compilan las guias. Por defecto, una carpeta temporal del sistema.
# El .aux y el .log nunca entran al vault.
# PLATAFORMA_TRABAJOS=./trabajos
