# Todas opcionales: la plataforma levanta sin ninguna. Copia a .env y ajusta.
#
# Aca NO van secretos de Canvas. La cookie de sesion de cada usuario vive fuera
# del repositorio, en %LOCALAPPDATA%\plataforma-estudio\<usuario>\canvas_session,
# y se pega desde la pantalla Cookie de Canvas.

# Donde escucha el servidor.
PLATAFORMA_PUERTO=8080
# 127.0.0.1 a proposito: esto guarda sesiones de Canvas de personas reales.
# Solo cambialo si sabes a que red lo estas exponiendo.
PLATAFORMA_HOST=127.0.0.1

# Ruta del archivo de usuarios. Util para levantar una instancia de prueba sin
# tocar la configuracion real.
# PLATAFORMA_USUARIOS=./usuarios.json

# Pimienta del hash de contraseñas. Si la cambias, las contraseñas existentes
# dejan de validar: es para elegirla una vez, al principio.
# PLATAFORMA_SECRETO=

# "cerrado" deja la creacion de usuarios solo en manos de un administrador.
# PLATAFORMA_REGISTRO=cerrado

# El modelo local. Tiene que estar bajado: ollama pull gemma4:e4b
#
# Cada modelo del registro trae su perfil (ventana de contexto, presupuesto de
# material, tokens por llamada, si razona, si acepta herramientas); esta en
# web/src/agente.mjs. Cambiar de modelo es cambiar esta linea.
#
# Las notas son del banco de pruebas (`npm run banco`), medido con tu material:
#
#   gemma4:e4b          6,1 GiB  98,7  el que viene puesto. Gano porque conserva
#                                      los datos duros: 15 de 15 fechas y salas
#   gemma4:12b          7,5 GiB  98,1  mas grande y aun asi pierde: llena la VRAM
#                                      y tarda 7,3 s por seccion contra 1,0
#   qwen3.5:4b-q4_K_M   3,1 GiB  95,1  el default anterior. Correcto y rapido,
#                                      pero inventa mas y deshace cifras
#   gemma4:e2b-it-qat   4,0 GiB  94,8  el repuesto si hace falta VRAM
#   llama3.1:latest     4,6 GiB  91,5  el peor medido: invento datos en 2 de 11
#                                      secciones. Esta por si hay que volver
#
# Un nombre que no este en el registro funciona igual: cae a un perfil generico
# conservador. Lo que ese modelo aguante de verdad, habra que medirlo.
OLLAMA_URL=http://127.0.0.1:11434
PLATAFORMA_MODELO=gemma4:e4b
# Milisegundos. Una guia son varias llamadas seguidas. Si no se declara, manda
# el timeout del perfil.
# PLATAFORMA_MODELO_TIMEOUT=180000
# Cuanto se queda el modelo cargado en la VRAM entre llamadas. Sin esto, una
# guia puede pagar la carga de los pesos una vez por seccion.
# PLATAFORMA_MODELO_KEEP_ALIVE=15m
# El canal de herramientas (tool_calls), apagado. Prenderlo NO le devuelve al
# modelo la decision de que material entra: el codigo sigue eligiendo.
# PLATAFORMA_TOOLS=0

# El motor de LaTeX. pdflatex por defecto porque no depende de fuentes
# instaladas; xelatex sirve si quieres la tipografia de marca.
# PLATAFORMA_LATEX=pdflatex
# Ruta al binario, si no esta en el PATH.
# PLATAFORMA_LATEX_BIN=
# PLATAFORMA_LATEX_TIMEOUT=60000

# Donde se compilan las guias. Por defecto, una carpeta temporal del sistema.
# El .aux y el .log nunca entran al vault.
# PLATAFORMA_TRABAJOS=./trabajos

# Donde viven las cookies de Canvas, una carpeta por usuario. En el contenedor
# apunta a /app/secretos, que es un volumen: sin eso habria que volver a pegar
# la cookie en cada `docker compose up`. Fuera de Docker, si no se declara, se
# usa %LOCALAPPDATA%\plataforma-estudio\.
# PLATAFORMA_COOKIES=secretos

# El archivo de sesiones abiertas. Mismo motivo: al volumen, para que bajar y
# levantar no eche a todo el mundo.
# PLATAFORMA_SESIONES=secretos/sesiones.json

# Donde se dejan los archivos que alguien sube para entregar en Canvas, una
# carpeta por usuario. Es la UNICA carpeta desde la que el MCP puede entregar:
# un archivo de fuera de aqui se rechaza, asi que acotarla es lo que impide que
# una entrega lleve una ruta arbitraria del disco.
#
# Son tareas de personas concretas: esta en .gitignore y en Docker va a un
# volumen. Fuera de Docker, si no se declara, se usa
# %LOCALAPPDATA%\plataforma-estudio\<usuario>\entregas.
# PLATAFORMA_ENTREGAS=entregas

# Donde se guarda la medicion de adopcion: el registro de eventos y las
# respuestas de la encuesta. Por defecto "metricas" en la raiz del proyecto.
#
# Son datos personales (quien entro, cuando y cuantas veces), asi que la carpeta
# esta en .gitignore y se monta como volumen. El cuadro de adopcion solo lo ve
# un administrador; cada estudiante ve su propia encuesta y nada mas.
# PLATAFORMA_METRICAS=metricas
